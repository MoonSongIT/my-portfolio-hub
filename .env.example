# Anthropic Claude API
# ⚠️ 서버사이드 fallback 키 — 사용자가 설정 페이지에서 본인 키를 등록하면 이 키보다 우선 사용됨
# 사용자 키는 브라우저 IndexedDB에 저장되며 X-User-Api-Key 헤더로 서버에 전달됨
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# Supabase (Phase 12 서버 확장 — https://supabase.com 에서 프로젝트 생성 후 발급)
# Dashboard → Project Settings → API 에서 확인
# VITE_ 접두사 = 브라우저에 노출됨 (anon key는 공개 가능, service_role key는 절대 VITE_ 사용 금지)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxx
# ⚠️ service_role 키는 서버사이드 전용 (Vercel 환경변수 / 로컬 .env 에만 저장, 절대 VITE_ 접두사 사용 금지)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxx

# 프론트엔드 API URL
VITE_API_BASE_URL=http://localhost:5173/api

# 주가 데이터 API
VITE_ALPHA_VANTAGE_KEY=xxxxxxxxxxxxxxxx
VITE_KRX_API_KEY=xxxxxxxxxxxxxxxx

# DART OpenAPI (공시 조회) — https://opendart.fss.or.kr 에서 무료 발급
DART_API_KEY=여기에_DART_키_입력

# 한국투자증권 OpenAPI (Phase 3~)
KIS_APP_KEY=xxxxxxxxxxxxxxxx
KIS_APP_SECRET=xxxxxxxxxxxxxxxx
KIS_ACCOUNT_NO=xxxxxxxxxxxxxxxx
