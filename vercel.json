{
  "functions": {
    "api/claude.js": {
      "maxDuration": 60
    },
    "api/naver-proxy.js": {
      "regions": ["icn1"]
    }
  },
  "rewrites": [
    { "source": "/api/naver/:path*",               "destination": "/api/naver-proxy?q=:path*" },
    { "source": "/api/yahoo-v10/:path*",           "destination": "https://query2.finance.yahoo.com/:path*" },
    { "source": "/api/yahoo/:path*",               "destination": "https://query1.finance.yahoo.com/:path*" },
    { "source": "/api/dart/calendar/dividend",     "destination": "/api/calendar?type=dart-dividend" },
    { "source": "/api/dart/calendar/earnings",     "destination": "/api/calendar?type=dart-earnings" },
    { "source": "/api/finnhub/calendar/earnings",  "destination": "/api/calendar?type=finnhub-earnings" },
    { "source": "/api/finnhub/calendar/ipo",       "destination": "/api/calendar?type=finnhub-ipo" },
    { "source": "/api/stock-master/meta",          "destination": "/api/stock-master?action=meta" },
    { "source": "/api/stock-master/download",      "destination": "/api/stock-master?action=download" },
    { "source": "/api/stock-master/upload",        "destination": "/api/stock-master?action=upload" },
    { "source": "/api/sync/download",              "destination": "/api/sync?action=download" },
    { "source": "/api/sync/upload",                "destination": "/api/sync?action=upload" },
    { "source": "/api/claude/validate",            "destination": "/api/claude?action=validate" },
    { "source": "/((?!api/).*)",                   "destination": "/index.html" }
  ]
}
